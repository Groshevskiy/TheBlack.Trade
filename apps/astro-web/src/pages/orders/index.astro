---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Orders">
  <section class="card hero">
    <div>
      <p class="eyebrow">Customer cabinet</p>
      <h2>Your orders</h2>
      <p class="lede">Полный список заявок клиента с фильтрами, метриками, quick insight по следующему действию и переходом в detail flow.</p>
    </div>
    <div class="hero-actions">
      <a class="primary-link" href="/">Create order</a>
      <button id="refresh" type="button">Refresh</button>
    </div>
  </section>

  <div id="notice" class="notice" hidden></div>

  <section class="metrics-grid">
    <article class="card metric-card">
      <span>Total orders</span>
      <strong id="stat-total">—</strong>
      <p>All customer requests visible in the cabinet.</p>
    </article>
    <article class="card metric-card accent">
      <span>Needs action</span>
      <strong id="stat-action">—</strong>
      <p>Orders that most likely require customer attention next.</p>
    </article>
    <article class="card metric-card">
      <span>In progress</span>
      <strong id="stat-open">—</strong>
      <p>Draft, awaiting payment, confirmed or processing orders.</p>
    </article>
    <article class="card metric-card">
      <span>Completed</span>
      <strong id="stat-completed">—</strong>
      <p>Closed lifecycle requests ready for archive-style review.</p>
    </article>
  </section>

  <section class="layout">
    <div class="stack">
      <section class="card filters-card">
        <div class="section-head">
          <div>
            <p class="eyebrow">Filters</p>
            <h3>Find the right order</h3>
          </div>
          <p id="summary" class="tiny">Loading orders…</p>
        </div>

        <div class="filters-grid">
          <label>
            <span>Status</span>
            <select id="statusFilter">
              <option value="all">All statuses</option>
              <option value="draft">draft</option>
              <option value="awaiting_payment">awaiting_payment</option>
              <option value="payment_confirmed">payment_confirmed</option>
              <option value="processing">processing</option>
              <option value="completed">completed</option>
              <option value="cancelled">cancelled</option>
              <option value="expired">expired</option>
            </select>
          </label>

          <label>
            <span>Search</span>
            <input id="searchFilter" type="search" placeholder="Public ID, asset, network" />
          </label>

          <label>
            <span>Sort</span>
            <select id="sortFilter">
              <option value="updated_desc">Recently updated</option>
              <option value="updated_asc">Oldest updated</option>
              <option value="fiat_desc">Largest fiat amount</option>
              <option value="fiat_asc">Smallest fiat amount</option>
            </select>
          </label>
        </div>
      </section>

      <section class="card list-card">
        <div class="section-head">
          <div>
            <p class="eyebrow">Orders feed</p>
            <h3>Customer lifecycle list</h3>
          </div>
          <span id="visibleCount" class="tiny">0 shown</span>
        </div>

        <div id="ordersList" class="orders-list">
          <p class="empty">Loading orders…</p>
        </div>
      </section>
    </div>

    <aside class="stack">
      <section class="card insight-card">
        <p class="eyebrow">Next step</p>
        <h3 id="insightTitle">Preparing insight…</h3>
        <p class="lede" id="insightCopy">The sidebar will explain the most important action based on visible orders.</p>
      </section>

      <section class="card">
        <div class="section-head">
          <div>
            <p class="eyebrow">Priority queue</p>
            <h3>Needs attention first</h3>
          </div>
        </div>
        <div id="priorityList" class="priority-list">
          <p class="empty">Loading queue…</p>
        </div>
      </section>
    </aside>
  </section>

  <style>
    .hero,.hero-actions,.section-head,.order-head,.order-meta,.priority-item{display:flex;justify-content:space-between;gap:16px;align-items:center}
    .hero{margin-bottom:16px;flex-wrap:wrap}.hero h2,.section-head h3,.insight-card h3{margin:4px 0 0}.eyebrow{margin:0;color:#8b98ab;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:700}.lede,.tiny,.metric-card p,.order-copy p,.priority-copy p{color:#b6c0cf}.hero-actions{margin-left:auto;flex-wrap:wrap}.hero-actions button,.primary-link,.filters-grid input,.filters-grid select{background:#0f1115;color:#f5f7fa;border:1px solid #2a2f3a;border-radius:10px;padding:10px 14px;font:inherit}.primary-link{background:#7dd3fc;border-color:#7dd3fc;color:#07111a;font-weight:700;display:inline-flex;align-items:center}.metrics-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:16px}.metric-card{display:grid;gap:8px}.metric-card span{color:#8b98ab;font-size:13px}.metric-card strong{font-size:30px}.metric-card.accent{background:linear-gradient(180deg,#171a21 0%,#131e24 100%)}.layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,.9fr);gap:16px}.stack{display:grid;gap:16px}.filters-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.filters-grid label{display:grid;gap:8px}.filters-grid span{color:#8b98ab;font-size:13px}.orders-list,.priority-list{display:grid;gap:12px}.order-card,.priority-item{padding:16px;border:1px solid #2a2f3a;border-radius:14px;background:#0f1115}.order-card{display:grid;gap:14px}.order-copy{display:grid;gap:6px}.order-copy h4,.priority-copy strong{margin:0}.order-meta{flex-wrap:wrap}.meta-line{display:flex;gap:12px;flex-wrap:wrap;color:#8b98ab;font-size:14px}.status{display:inline-flex;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid currentColor;text-transform:capitalize}.status.completed{color:#86efac}.status.processing{color:#fde68a}.status.awaiting_payment,.status.payment_confirmed{color:#7dd3fc}.status.cancelled,.status.expired{color:#fca5a5}.status.draft{color:#d8b4fe}.cta-row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.cta-row a{display:inline-flex;padding:9px 12px;border:1px solid #2a2f3a;border-radius:10px;color:#f5f7fa}.amounts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.amounts div{padding:12px;border-radius:10px;background:#151922;border:1px solid #222937}.amounts span{display:block;color:#8b98ab;font-size:12px}.amounts strong{display:block;margin-top:4px}.priority-item{align-items:flex-start}.priority-copy{display:grid;gap:4px}.empty{color:#8b98ab}.notice{margin:0 0 16px;padding:12px 14px;border:1px solid #7f1d1d;background:#2b1618;border-radius:10px;color:#fecaca}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}@media(max-width:1080px){.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:1fr}}@media(max-width:720px){.metrics-grid,.filters-grid,.amounts{grid-template-columns:1fr}.hero,.hero-actions,.section-head,.order-head,.order-meta,.priority-item,.cta-row{align-items:flex-start;flex-direction:column}}
  </style>

  <script type="module">
    import "../../scripts/orders-page.ts";
  </script>
</BaseLayout>
