---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Account">
  <section class="card hero">
    <div>
      <p class="eyebrow">Customer profile</p>
      <h2>Account overview</h2>
      <p class="lede">Контактные данные, KYC-статус, связанные заказы и сохранённые платёжные данные текущего пользователя.</p>
    </div>
    <button id="refresh" type="button">Refresh</button>
  </section>

  <div id="notice" class="notice" hidden></div>

  <section class="grid stats">
    <div class="card stat"><span>KYC level</span><strong id="kycValue">—</strong></div>
    <div class="card stat"><span>Status</span><strong id="statusValue">—</strong></div>
    <div class="card stat"><span>Orders</span><strong id="ordersValue">—</strong></div>
    <div class="card stat"><span>Unread notifications</span><strong id="notificationsValue">—</strong></div>
  </section>

  <section class="grid panels">
    <section class="card">
      <div class="panel-head">
        <div><p class="eyebrow">Identity</p><h2>Contact details</h2></div>
      </div>
      <div class="feed" id="identityCard"><p class="empty">Loading profile…</p></div>
    </section>

    <section class="card">
      <div class="panel-head">
        <div><p class="eyebrow">Assets</p><h2>Saved payment data</h2></div>
      </div>
      <div class="feed" id="assetsCard"><p class="empty">Loading payment data…</p></div>
    </section>

    <section class="card panel-wide">
      <div class="panel-head">
        <div><p class="eyebrow">Activity</p><h2>Recent customer orders</h2></div>
        <a href="/orders">Open orders</a>
      </div>
      <div class="feed" id="ordersCard"><p class="empty">Loading orders…</p></div>
    </section>
  </section>

  <style>
    .hero,.panel-head,.stat{display:flex;justify-content:space-between;gap:16px;align-items:center}.hero{margin-bottom:16px;flex-wrap:wrap}.hero h2,.panel-head h2{margin:4px 0 0}.eyebrow{margin:0;color:#8b98ab;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:700}.lede{color:#b6c0cf}.hero button{background:#0f1115;color:#f5f7fa;border:1px solid #2a2f3a;border-radius:10px;padding:10px 14px;font:inherit;cursor:pointer}.notice{margin:0 0 16px;padding:12px 14px;border:1px solid #7f1d1d;background:#2b1618;border-radius:10px;color:#fecaca}.stats{margin-bottom:16px}.stat{align-items:flex-start;flex-direction:column}.stat span{color:#8b98ab;font-size:13px}.stat strong{font-size:28px;text-transform:capitalize}.panels{align-items:start}.panel-wide{grid-column:span 2}.feed{display:grid;gap:12px}.feed-item{padding:14px;border:1px solid #2a2f3a;border-radius:12px;background:#11151c}.feed-item h3,.feed-item p{margin:0}.feed-item p{color:#b6c0cf;font-size:14px}.feed-meta{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:8px}.status{display:inline-flex;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid currentColor}.status.completed{color:#86efac}.status.processing{color:#fde68a}.status.awaiting_payment,.status.payment_confirmed{color:#7dd3fc}.status.cancelled,.status.expired{color:#fca5a5}.status.draft{color:#d8b4fe}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.empty{color:#8b98ab}@media(max-width:860px){.panel-wide{grid-column:span 1}.hero button{width:100%}}
  </style>

  <script>
    const API = `${window.location.protocol}//${window.location.hostname}:4000/api`;
    const date = (value) => value ? new Date(value).toLocaleString('ru-RU', { dateStyle: 'short', timeStyle: 'short' }) : '—';
    const cut = (value) => value ? `${String(value).slice(0, 10)}…` : '—';

    function setNotice(message = '') {
      const box = document.getElementById('notice');
      box.hidden = !message;
      box.textContent = message;
    }

    async function fetchJson(url) {
      const response = await fetch(url);
      const data = await response.json();
      if (!response.ok) throw new Error(data?.message || 'Request failed');
      return data;
    }

    function renderIdentity(user, metrics) {
      document.getElementById('kycValue').textContent = user.kycLevel || '—';
      document.getElementById('statusValue').textContent = user.status || '—';
      document.getElementById('ordersValue').textContent = String(metrics.orders ?? 0);
      document.getElementById('notificationsValue').textContent = String(metrics.unreadNotifications ?? 0);
      document.getElementById('identityCard').innerHTML = `
        <article class="feed-item">
          <div class="feed-meta"><strong>User ID</strong><span class="mono">${user.id}</span></div>
          <p>Email: ${user.email || '—'}</p>
          <p>Phone: ${user.phone || '—'}</p>
          <p>Telegram: ${user.telegram || '—'}</p>
          <p>Locale: ${user.locale || '—'}</p>
          <p>Joined: ${date(user.createdAt)}</p>
        </article>`;
    }

    function renderAssets(wallets, payouts) {
      document.getElementById('assetsCard').innerHTML = `
        <article class="feed-item">
          <div class="feed-meta"><strong>Wallets</strong><span>${wallets.length}</span></div>
          <p>${wallets.length ? wallets.map((item) => item.label || cut(item.address)).join(', ') : 'No wallets saved'}</p>
        </article>
        <article class="feed-item">
          <div class="feed-meta"><strong>Payout methods</strong><span>${payouts.length}</span></div>
          <p>${payouts.length ? payouts.map((item) => item.requisiteType || item.bankName || 'method').join(', ') : 'No payout methods saved'}</p>
        </article>`;
    }

    function renderOrders(items) {
      document.getElementById('ordersCard').innerHTML = items.length ? items.slice(0, 5).map((item) => `
        <article class="feed-item">
          <div class="feed-meta"><strong class="mono">${item.publicId}</strong><span class="status ${item.statusCode}">${item.statusCode}</span></div>
          <p>${item.directionCode} · Updated ${date(item.updatedAt)}</p>
          <p><a href="/orders/${item.publicId}">Open order</a></p>
        </article>`).join('') : '<p class="empty">No orders yet.</p>';
    }

    async function loadAccount() {
      try {
        setNotice('');
        const data = await fetchJson(`${API}/auth/me/summary`);
        const item = data.item || {};
        renderIdentity(item.user || {}, item.metrics || {});
        renderAssets(item.wallets || [], item.payoutRequisites || []);
        renderOrders(item.orders || []);
      } catch (error) {
        console.error('account load failed', error);
        setNotice(error.message || 'Unable to load account');
      }
    }

    document.getElementById('refresh').addEventListener('click', loadAccount);
    loadAccount();
  </script>
</BaseLayout>
