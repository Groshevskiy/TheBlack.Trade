---
import BaseLayout from "../layouts/BaseLayout.astro";
import CabinetHero from "../components/CabinetHero.astro";
import MetricCard from "../components/MetricCard.astro";
import SectionHead from "../components/SectionHead.astro";
---
<BaseLayout title="Account">
  <CabinetHero
    eyebrow="Customer profile"
    title="Account overview"
    lede="Единая customer identity view: профиль, KYC, saved settlement details, recent order activity и unread updates."
    actionHref="/"
    actionLabel="Create order"
  />

  <div id="notice" class="notice" hidden></div>

  <section class="metrics-grid">
    <MetricCard
      label="KYC level"
      valueId="kycValue"
      description="Current verification tier used by the customer profile."
      accent={true}
    />
    <MetricCard
      label="Status"
      valueId="statusValue"
      description="Current account state across the cabinet."
    />
    <MetricCard
      label="Total orders"
      valueId="ordersValue"
      description="Requests already linked to the current customer."
    />
    <MetricCard
      label="Unread notifications"
      valueId="notificationsValue"
      description="Updates still waiting for review."
    />
  </section>

  <section class="layout">
    <div class="stack">
      <section class="card">
        <SectionHead eyebrow="Identity" title="Profile and contact details" />
        <div id="identityCard" class="feed"><p class="empty">Loading profile…</p></div>
      </section>

      <section class="two-col">
        <section class="card">
          <SectionHead eyebrow="Settlement" title="Saved destinations" linkHref="/wallets" linkLabel="Open wallets" />
          <div id="assetsCard" class="feed"><p class="empty">Loading payment data…</p></div>
        </section>

        <section class="card insight-card">
          <p class="eyebrow">Profile insight</p>
          <h3 id="insightTitle">Preparing insight…</h3>
          <p class="lede" id="insightCopy">This panel summarizes the most important customer profile context for operations.</p>
        </section>
      </section>

      <section class="card panel-wide">
        <SectionHead eyebrow="Activity" title="Recent customer orders" linkHref="/orders" linkLabel="Open orders" />
        <div id="ordersCard" class="feed"><p class="empty">Loading orders…</p></div>
      </section>
    </div>

    <aside class="stack">
      <section class="card">
        <SectionHead eyebrow="Notifications" title="Unread updates" linkHref="/notifications" linkLabel="Open all" />
        <div id="notificationsCard" class="feed"><p class="empty">Loading notifications…</p></div>
      </section>

      <section class="card">
        <SectionHead eyebrow="Quick links" title="Customer journey" />
        <div class="quick-links">
          <a href="/">Create a new order</a>
          <a href="/orders">Track all orders</a>
          <a href="/wallets">Check settlement destinations</a>
          <a href="/notifications">Review notifications</a>
        </div>
      </section>
    </aside>
  </section>

  <style>
    .notice{margin:0 0 16px;padding:12px 14px;border:1px solid #7f1d1d;background:#2b1618;border-radius:10px;color:#fecaca}.metrics-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:16px}.feed-meta{display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}.insight-card h3{margin:4px 0 0}.eyebrow{margin:0;color:#8b98ab;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:700}.lede,.feed-item p{color:#b6c0cf}.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.95fr);gap:16px}.stack,.feed,.quick-links{display:grid;gap:16px}.two-col{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.panel-wide{min-height:0}.feed-item{padding:14px;border:1px solid #2a2f3a;border-radius:12px;background:#11151c;display:grid;gap:8px}.feed-item h4,.feed-item p{margin:0}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.empty{color:#8b98ab}.text-link{color:#7dd3fc}.quick-links a{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border:1px solid #2a2f3a;border-radius:12px;background:#0f1115}.status-pill{display:inline-flex;align-items:center;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid currentColor}.status-pill.completed{color:#86efac}.status-pill.processing{color:#fde68a}.status-pill.awaiting_payment,.status-pill.payment_confirmed,.status-pill.neutral{color:#7dd3fc}.status-pill.cancelled,.status-pill.expired{color:#fca5a5}.status-pill.draft{color:#d8b4fe}@media(max-width:1120px){.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:1fr}}@media(max-width:760px){.metrics-grid,.two-col{grid-template-columns:1fr}.feed-meta{align-items:flex-start;flex-direction:column}}
  </style>

  <script>
    const API = `${window.location.protocol}//${window.location.hostname}:4000/api`;
    const identityCardEl = document.getElementById('identityCard');
    const assetsCardEl = document.getElementById('assetsCard');
    const ordersCardEl = document.getElementById('ordersCard');
    const notificationsCardEl = document.getElementById('notificationsCard');
    const noticeEl = document.getElementById('notice');
    const refreshBtn = document.getElementById('refresh');
    const insightTitleEl = document.getElementById('insightTitle');
    const insightCopyEl = document.getElementById('insightCopy');

    const date = (value) => value ? new Date(value).toLocaleString('ru-RU', { dateStyle: 'short', timeStyle: 'short' }) : '—';
    const cut = (value) => value ? `${String(value).slice(0, 10)}…` : '—';
    const pillMarkup = (text, tone) => `<span class="status-pill ${tone}">${text}</span>`;

    function setNotice(message = '') {
      noticeEl.hidden = !message;
      noticeEl.textContent = message;
    }

    function normalizeStatus(order) {
      return order.statusCode || order.status_code || 'draft';
    }

    async function fetchJson(path) {
      const response = await fetch(`${API}${path}`);
      const payload = await response.json().catch(() => null);
      if (!response.ok) throw new Error(payload?.message || `HTTP ${response.status}`);
      return payload;
    }

    function renderIdentity(user, metrics) {
      document.getElementById('kycValue').textContent = user.kycLevel || user.kyc_level || '—';
      document.getElementById('statusValue').textContent = user.status || '—';
      document.getElementById('ordersValue').textContent = String(metrics.totalOrders ?? metrics.orders ?? 0);
      document.getElementById('notificationsValue').textContent = String(metrics.unreadNotifications ?? 0);
      identityCardEl.innerHTML = `
        <article class="feed-item">
          <div class="feed-meta"><strong>User ID</strong><span class="mono">${user.id || '—'}</span></div>
          <p>Email: ${user.email || '—'}</p>
          <p>Phone: ${user.phone || '—'}</p>
          <p>Telegram: ${user.telegram || '—'}</p>
          <p>Locale: ${user.locale || '—'}</p>
          <p>Joined: ${date(user.createdAt)}</p>
        </article>`;
    }

    function renderAssets(wallets = [], payouts = []) {
      assetsCardEl.innerHTML = `
        <article class="feed-item">
          <h4>Saved wallets</h4>
          <p>${wallets.length} destinations stored for crypto settlement.</p>
          <p>${wallets[0] ? `${wallets[0].assetCode || wallets[0].asset_code || 'Asset'} · ${cut(wallets[0].address)}` : 'No wallets saved yet.'}</p>
        </article>
        <article class="feed-item">
          <h4>Payout methods</h4>
          <p>${payouts.length} fiat requisites stored for payouts.</p>
          <p>${payouts[0] ? `${payouts[0].bankName || payouts[0].providerName || 'Method'} · ${payouts[0].fiatCurrencyCode || payouts[0].fiat_currency_code || '—'}` : 'No payout methods saved yet.'}</p>
        </article>`;
    }

    function renderOrders(items = []) {
      if (!items.length) {
        ordersCardEl.innerHTML = '<p class="empty">No customer orders available.</p>';
        return;
      }
      ordersCardEl.innerHTML = items.slice(0, 5).map((item) => `
        <article class="feed-item">
          <div class="feed-meta">
            <h4>${item.publicId || item.public_id || '—'}</h4>
            ${pillMarkup(normalizeStatus(item), normalizeStatus(item))}
          </div>
          <p>${item.directionCode || item.direction_code || '—'} · ${item.assetCode || item.asset_code || '—'}</p>
          <p>Updated ${date(item.updatedAt)}</p>
          <a class="text-link" href="/orders/${item.publicId || item.public_id}">Open detail</a>
        </article>
      `).join('');
    }

    function renderNotifications(items = []) {
      const unread = items.filter((item) => item.isRead === false || item.is_read === false).slice(0, 5);
      if (!unread.length) {
        notificationsCardEl.innerHTML = '<p class="empty">No unread customer updates.</p>';
        return;
      }
      notificationsCardEl.innerHTML = unread.map((item) => `
        <article class="feed-item">
          <div class="feed-meta">
            <h4>${item.title || item.templateCode || item.template_code || 'Notification'}</h4>
            <span>${date(item.createdAt)}</span>
          </div>
          <p>${item.body || 'No message body'}</p>
        </article>
      `).join('');
    }

    function renderInsight(user, wallets = [], payouts = [], orders = [], notifications = []) {
      const unread = notifications.filter((item) => item.isRead === false || item.is_read === false).length;
      const activeOrders = orders.filter((item) => ['draft', 'awaiting_payment', 'payment_confirmed', 'processing'].includes(normalizeStatus(item))).length;

      if (user.status && user.status !== 'active') {
        insightTitleEl.textContent = 'Account status needs attention';
        insightCopyEl.textContent = 'The customer profile is not fully active, so operations should confirm account readiness before deep lifecycle progression.';
        return;
      }
      if ((wallets.length === 0 || payouts.length === 0) && activeOrders > 0) {
        insightTitleEl.textContent = 'Settlement profile is incomplete';
        insightCopyEl.textContent = 'There are active orders, but part of the saved settlement data is missing. Review wallets and payout methods before later order stages.';
        return;
      }
      if (unread > 0) {
        insightTitleEl.textContent = 'Unread updates remain open';
        insightCopyEl.textContent = 'The account is otherwise healthy, but unread customer-facing notifications still need review to maintain good lifecycle visibility.';
        return;
      }
      insightTitleEl.textContent = 'Customer profile is in good shape';
      insightCopyEl.textContent = 'Identity, settlement details and lifecycle activity look connected well enough for smooth customer operations.';
    }

    async function loadAccount() {
      refreshBtn.disabled = true;
      setNotice('');
      try {
        const [summary, ordersSummary, wallets, payouts, notifications] = await Promise.all([
          fetchJson('/auth/me/summary'),
          fetchJson('/auth/me/orders-summary'),
          fetchJson('/wallets'),
          fetchJson('/payout-requisites'),
          fetchJson('/notifications'),
        ]);

        const user = summary?.user || summary?.item?.user || {};
        const metrics = summary?.metrics || summary?.item?.metrics || {};
        const orderItems = Array.isArray(ordersSummary?.items) ? ordersSummary.items : [];
        const walletItems = Array.isArray(wallets?.items) ? wallets.items : [];
        const payoutItems = Array.isArray(payouts?.items) ? payouts.items : [];
        const notificationItems = Array.isArray(notifications?.items) ? notifications.items : [];

        renderIdentity(user, metrics);
        renderAssets(walletItems, payoutItems);
        renderOrders(orderItems);
        renderNotifications(notificationItems);
        renderInsight(user, walletItems, payoutItems, orderItems, notificationItems);
      } catch (error) {
        identityCardEl.innerHTML = '<p class="empty">Unable to load profile.</p>';
        assetsCardEl.innerHTML = '<p class="empty">Unable to load saved destinations.</p>';
        ordersCardEl.innerHTML = '<p class="empty">Unable to load order activity.</p>';
        notificationsCardEl.innerHTML = '<p class="empty">Unable to load notifications.</p>';
        setNotice(error.message || 'Failed to load account overview.');
      } finally {
        refreshBtn.disabled = false;
      }
    }

    refreshBtn.addEventListener('click', loadAccount);
    loadAccount();
  </script>
</BaseLayout>
