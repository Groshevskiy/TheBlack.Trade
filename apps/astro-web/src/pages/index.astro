---
const orderId = 'ord_1791025821182';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>TheBlack.Trade — Order Operations</title>
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&f[]=cabinet-grotesk@500,700&display=swap" rel="stylesheet" />
    <style>
      :root{--bg:#10110f;--surface:#171816;--surface2:#20211e;--line:#343630;--text:#e4e2db;--muted:#9a9b91;--faint:#696b64;--accent:#69c8bb;--accent-bg:#163a35;--ok:#89c76a;--warn:#e8ba5d;--danger:#e87d78;--r:12px;--s1:4px;--s2:8px;--s3:12px;--s4:16px;--s6:24px;--s8:32px;--s12:48px;--font:'Satoshi',Arial,sans-serif;--display:'Cabinet Grotesk',Arial,sans-serif}
      *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.5 var(--font)}button{font:inherit;cursor:pointer}.app{display:grid;grid-template-columns:236px 1fr;min-height:100vh}.side{background:#141512;border-right:1px solid var(--line);padding:var(--s6) var(--s4);display:flex;flex-direction:column;gap:var(--s8)}.brand{display:flex;align-items:center;gap:var(--s3);font:700 19px var(--display);letter-spacing:-.03em}.mark{width:30px;height:30px;border:2px solid var(--accent);border-radius:8px;position:relative}.mark:after{content:'';position:absolute;width:10px;height:10px;background:var(--accent);right:-4px;top:-4px;border-radius:50%}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:var(--faint);font-weight:700}.nav{display:grid;gap:4px}.nav a{color:var(--muted);text-decoration:none;padding:10px 12px;border-radius:8px}.nav a.active{background:var(--surface2);color:var(--text)}.profile{margin-top:auto;border-top:1px solid var(--line);padding-top:var(--s4);font-size:14px;color:var(--muted)}main{padding:var(--s8);max-width:1500px;width:100%;margin:auto}.top{display:flex;align-items:center;justify-content:space-between;gap:var(--s4);margin-bottom:var(--s8)}h1,h2,h3,p{margin:0}h1{font:700 clamp(26px,3vw,36px)/1.15 var(--display);letter-spacing:-.04em}h2{font:700 20px var(--display);letter-spacing:-.02em}.sub{color:var(--muted);margin-top:6px}.btn{border:1px solid var(--line);background:transparent;color:var(--text);padding:10px 14px;border-radius:8px;min-height:42px}.btn.primary{background:var(--accent);color:#10211e;border-color:var(--accent);font-weight:700}.btn:disabled{opacity:.5;cursor:not-allowed}.notice{display:none;margin-bottom:var(--s4);padding:12px 14px;border:1px solid #416d64;background:#17332e;border-radius:8px;color:#c9f2e9}.grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(310px,.9fr);gap:var(--s6)}.stack{display:grid;gap:var(--s6)}.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:var(--s6)}.summary{display:flex;justify-content:space-between;gap:var(--s6);align-items:flex-start}.status{color:var(--ok);background:#203720;border:1px solid #3d6134;border-radius:999px;padding:5px 10px;font-size:13px;font-weight:700;text-transform:capitalize}.amount{font:700 30px var(--display);letter-spacing:-.04em;margin-top:var(--s4)}.meta{color:var(--muted);font-size:14px}.rule{height:1px;background:var(--line);margin:var(--s6) 0}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s4)}.facts b{display:block;font-size:15px}.timeline{margin-top:var(--s6);display:grid;gap:0}.event{display:grid;grid-template-columns:18px 1fr;gap:var(--s3);padding-bottom:var(--s5)}.dot{width:10px;height:10px;margin-top:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--accent-bg)}.event:not(:last-child) .dot{position:relative}.event:not(:last-child) .dot:after{content:'';position:absolute;top:14px;left:4px;width:2px;height:42px;background:var(--line)}.event-title{font-weight:700}.event small{color:var(--muted)}.actions{display:grid;gap:var(--s3);margin-top:var(--s4)}.action{display:flex;justify-content:space-between;align-items:center;border:1px solid var(--line);background:var(--surface2);padding:12px;border-radius:8px}.action button{padding:7px 10px;border:1px solid var(--accent);background:transparent;color:var(--accent);border-radius:6px;font-size:13px}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--s4)}.feed{display:grid;gap:var(--s3)}.feed-item{padding:12px 0;border-bottom:1px solid var(--line)}.feed-item:last-child{border:0}.feed-item b{font-size:14px}.feed-item p{font-size:14px;color:var(--muted);margin-top:2px}.empty{color:var(--muted);font-size:14px;padding:var(--s4) 0}.loading{animation:pulse 1.2s infinite;background:linear-gradient(90deg,#1a1b19,#292a27,#1a1b19);background-size:200% 100%;height:18px;border-radius:4px}@keyframes pulse{to{background-position:-200% 0}}@media(max-width:820px){.app{display:block}.side{display:none}main{padding:var(--s4)}.top{align-items:flex-start;flex-direction:column}.grid{grid-template-columns:1fr}.facts{grid-template-columns:1fr 1fr}.card{padding:var(--s4)}}
    </style>
  </head>
  <body>
    <div class="app">
      <aside class="side"><div class="brand"><span class="mark"></span><span>TheBlack.Trade</span></div><div><p class="eyebrow">Operations</p><nav class="nav"><a href="#">Overview</a><a href="#" class="active">Orders</a><a href="#">Documents</a><a href="#">Notifications</a><a href="#">Webhooks</a></nav></div><div class="profile"><b>operator_demo_01</b><br />Operator workspace</div></aside>
      <main>
        <div class="top"><div><p class="eyebrow">Order workspace</p><h1>Order <span id="public-id">{orderId}</span></h1><p class="sub">Customer, execution and audit context in one view.</p></div><button class="btn" id="refresh">Refresh</button></div>
        <div class="notice" id="notice"></div>
        <div class="grid"><div class="stack">
          <section class="card"><div class="summary"><div><p class="eyebrow">Current order</p><div class="amount" id="amount"><span class="loading" style="display:inline-block;width:160px"></span></div><p class="meta" id="pair">Loading order details…</p></div><span class="status" id="status">Loading</span></div><div class="rule"></div><div class="facts"><div><p class="eyebrow">Rate</p><b id="rate">—</b></div><div><p class="eyebrow">Created</p><b id="created">—</b></div><div><p class="eyebrow">Wallet</p><b id="wallet">—</b></div></div></section>
          <section class="card"><div class="section-head"><div><p class="eyebrow">Lifecycle</p><h2>Order timeline</h2></div></div><div class="timeline" id="timeline"><p class="empty">Loading timeline…</p></div></section>
        </div><div class="stack">
          <section class="card"><p class="eyebrow">Operator controls</p><h2>Available actions</h2><div class="actions" id="actions"><p class="empty">Loading available actions…</p></div></section>
          <section class="card"><div class="section-head"><div><p class="eyebrow">Compliance</p><h2>Documents</h2></div></div><div class="feed" id="documents"><p class="empty">Loading documents…</p></div></section>
          <section class="card"><div class="section-head"><div><p class="eyebrow">Outbound</p><h2>Webhook & audit</h2></div></div><div class="feed" id="audit"><p class="empty">Loading audit events…</p></div></section>
        </div></div>
      </main>
    </div>
    <script define:vars={{ orderId }}>
      const API='http://localhost:4000/api'; const operator='operator_demo_01';
      const $=s=>document.querySelector(s); const el=(tag,cls,html)=>{const x=document.createElement(tag);x.className=cls||'';x.innerHTML=html||'';return x};
      const json=async u=>{const r=await fetch(u);if(!r.ok)throw new Error(await r.text());return r.json()};
      const date=v=>v?new Date(v).toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short'}):'—';
      const actionsByStatus={draft:[['cancel','Cancel order']],awaiting_payment:[['confirm_payment','Confirm payment'],['cancel','Cancel order']],payment_confirmed:[['start_processing','Start processing'],['cancel','Cancel order']],processing:[['complete','Complete order'],['cancel','Cancel order']],completed:[],cancelled:[],expired:[]};
      function notice(text,err=false){const n=$('#notice');n.textContent=text;n.style.display='block';n.style.background=err?'#4b2525':'#17332e';n.style.borderColor=err?'#8d4b4b':'#416d64'}
      async function postAction(code){const key=`ui-${code}-${orderId}-${Date.now()}`;const r=await fetch(`${API}/orders/${orderId}/actions`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action_code:code,operator_id:operator,idempotency_key:key,request_id:`ui_${Date.now()}`,payload:{source:'operator_workspace'}})});const out=await r.json();if(!r.ok)throw new Error(out.message||'Action failed');notice(`Action “${code}” completed. Status is now ${out.order.statusCode}.`);await load()}
      async function load(){try{const order=await json(`${API}/orders/${orderId}`);$('#public-id').textContent=order.publicId;$('#amount').textContent=`${Number(order.fiatAmount).toLocaleString('en-US')} fiat`;$('#pair').textContent=`${order.directionCode.toUpperCase()} · ${Number(order.cryptoAmount).toLocaleString('en-US')} crypto`;$('#status').textContent=order.statusCode.replaceAll('_',' ');$('#rate').textContent=order.rate;$('#created').textContent=date(order.createdAt);$('#wallet').textContent=order.walletId?.slice(0,8)+'…'||'—';
        const [tl,docs,audit]=await Promise.all([json(`${API}/orders/${orderId}/timeline`),json(`${API}/documents?order_id=${order.id}`),json(`${API}/audit-logs?entity_type=order&entity_id=${order.id}`)]);
        const t=$('#timeline');t.innerHTML='';tl.items.forEach(i=>t.append(el('div','event',`<span class="dot"></span><div><div class="event-title">${i.eventType.replaceAll('_',' ')}</div><small>${i.fromStatus||'—'} → ${i.toStatus||'—'} · ${date(i.createdAt)}</small></div>`)));
        const d=$('#documents');d.innerHTML=docs.items.length?'':'';docs.items.forEach(i=>d.append(el('div','feed-item',`<b>${i.documentType.replaceAll('_',' ')}</b><p>${i.status} · ${date(i.createdAt)}</p>`)));if(!docs.items.length)d.innerHTML='<p class="empty">No documents attached.</p>';
        const a=$('#audit');a.innerHTML=audit.items.length?'':'';audit.items.forEach(i=>a.append(el('div','feed-item',`<b>${i.action}</b><p>${i.actorId||'system'} · ${date(i.createdAt)}</p>`)));if(!audit.items.length)a.innerHTML='<p class="empty">No audit events yet.</p>';
        const box=$('#actions');box.innerHTML='';const available=actionsByStatus[order.statusCode]||[];if(!available.length)box.innerHTML='<p class="empty">No actions available for this terminal status.</p>';available.forEach(([code,label])=>{const row=el('div','action',`<span>${label}</span><button>${label}</button>`);row.querySelector('button').onclick=()=>postAction(code).catch(e=>notice(e.message,true));box.append(row)});
      }catch(e){notice(`Unable to load order workspace: ${e.message}`,true);$('#timeline').innerHTML='<p class="empty">Try refreshing after the API is available.</p>'}}
      $('#refresh').onclick=load;load();
    </script>
  </body>
</html>
