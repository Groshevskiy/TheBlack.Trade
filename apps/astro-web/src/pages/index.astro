---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="TheBlack.Trade — Create order">
  <section class="hero card">
    <div>
      <p class="eyebrow">Customer cabinet</p>
      <h2>Create a new order</h2>
      <p class="lede">Рассчитайте quote, создайте заявку и сразу перейдите в карточку сделки с timeline и дальнейшими действиями.</p>
    </div>
    <a class="ghost-link" href="/orders">Open orders list</a>
  </section>

  <div id="notice" class="notice" hidden></div>

  <section class="layout">
    <div class="stack">
      <section class="card">
        <div class="section-head">
          <div>
            <p class="eyebrow">Step 1</p>
            <h3>Quote input</h3>
          </div>
          <span class="tiny">Live API flow</span>
        </div>

        <form id="quoteForm" class="form-grid">
          <label>
            <span>Direction</span>
            <select id="direction" name="direction_code">
              <option value="buy">buy</option>
              <option value="sell">sell</option>
            </select>
          </label>

          <label>
            <span>Asset</span>
            <select id="asset" name="asset_code"></select>
          </label>

          <label>
            <span>Network</span>
            <select id="network" name="network_code"></select>
          </label>

          <label>
            <span>Amount type</span>
            <select id="amountType" name="amount_type">
              <option value="fiat">fiat</option>
              <option value="crypto">crypto</option>
            </select>
          </label>

          <label>
            <span>Amount</span>
            <input id="amount" name="amount" type="number" min="0.0001" step="0.0001" value="15000" required />
          </label>

          <label>
            <span>Fiat currency</span>
            <input id="fiatCurrency" name="fiat_currency_code" type="text" value="RUB" maxlength="10" required />
          </label>

          <div class="form-actions">
            <button type="submit" class="btn primary" id="calculateBtn">Calculate quote</button>
            <button type="button" class="btn" id="resetBtn">Reset</button>
          </div>
        </form>
      </section>

      <section class="card" id="quoteCard">
        <div class="section-head">
          <div>
            <p class="eyebrow">Step 2</p>
            <h3>Quote preview</h3>
          </div>
          <span class="tiny" id="quoteState">Waiting for calculation</span>
        </div>

        <div id="quoteEmpty" class="empty-state">
          <p>Выберите направление, актив, сеть и сумму. После расчёта здесь появятся идентификатор quote, итоговые суммы и курс.</p>
        </div>

        <div id="quoteResult" class="quote-result" hidden>
          <div class="hero-metric">
            <span class="metric-label">Quote ID</span>
            <strong id="quoteId" class="mono">—</strong>
          </div>
          <div class="facts-grid">
            <div><span>Direction</span><strong id="quoteDirection">—</strong></div>
            <div><span>Asset</span><strong id="quoteAsset">—</strong></div>
            <div><span>Network</span><strong id="quoteNetwork">—</strong></div>
            <div><span>Fiat amount</span><strong id="quoteFiat">—</strong></div>
            <div><span>Crypto amount</span><strong id="quoteCrypto">—</strong></div>
            <div><span>Rate</span><strong id="quoteRate">—</strong></div>
          </div>
          <div class="rule"></div>
          <div class="quote-actions">
            <p class="helper">Создание order использует реальный backend contract с обязательными <span class="mono">quote_id</span> и <span class="mono">user_id</span>.</p>
            <button id="createOrderBtn" type="button" class="btn primary">Create order</button>
          </div>
        </div>
      </section>
    </div>

    <aside class="stack">
      <section class="card accent-card">
        <p class="eyebrow">Flow</p>
        <h3>Customer journey</h3>
        <ol class="flow-list">
          <li>Load active assets and networks from reference endpoints.</li>
          <li>Calculate a quote for fiat or crypto amount.</li>
          <li>Create an order for the demo user.</li>
          <li>Open the order detail card with timeline and actions.</li>
        </ol>
      </section>

      <section class="card">
        <div class="section-head">
          <div>
            <p class="eyebrow">Latest order</p>
            <h3>Quick jump</h3>
          </div>
        </div>
        <div id="latestOrder" class="empty-state compact">
          <p>После создания новой заявки здесь появится быстрый переход в detail flow.</p>
        </div>
      </section>
    </aside>
  </section>

  <style>
    .hero,.section-head,.quote-actions,.form-actions{display:flex;justify-content:space-between;gap:16px;align-items:center}
    .hero{margin-bottom:16px;flex-wrap:wrap}.hero h2,.card h3{margin:4px 0 0}.eyebrow{margin:0;color:#8b98ab;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:700}.lede,.helper,.tiny{color:#b6c0cf}.tiny{font-size:13px}.ghost-link{display:inline-flex;align-items:center;padding:10px 14px;border:1px solid #2a2f3a;border-radius:10px;color:#f5f7fa}.layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,.9fr);gap:16px}.stack{display:grid;gap:16px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.form-grid label{display:grid;gap:8px}.form-grid span,.facts-grid span,.metric-label{color:#8b98ab;font-size:13px}.form-grid input,.form-grid select{background:#0f1115;color:#f5f7fa;border:1px solid #2a2f3a;border-radius:10px;padding:12px 14px;font:inherit}.form-actions{grid-column:1 / -1;justify-content:flex-start;align-items:flex-end;flex-wrap:wrap}.btn{background:#0f1115;color:#f5f7fa;border:1px solid #2a2f3a;border-radius:10px;padding:12px 14px;font:inherit;cursor:pointer;min-height:44px}.btn.primary{background:#7dd3fc;color:#07111a;border-color:#7dd3fc;font-weight:700}.btn:disabled{opacity:.6;cursor:not-allowed}.notice{margin:0 0 16px;padding:12px 14px;border:1px solid #7f1d1d;background:#2b1618;border-radius:10px;color:#fecaca}.notice.success{border-color:#1f5e45;background:#10281f;color:#bbf7d0}.quote-result{display:grid;gap:16px}.hero-metric strong{display:block;font-size:24px;margin-top:6px}.facts-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.facts-grid strong{display:block;margin-top:4px;font-size:16px}.rule{height:1px;background:#2a2f3a}.empty-state{color:#b6c0cf}.empty-state.compact{font-size:14px}.accent-card{background:linear-gradient(180deg,#171a21 0%,#131e24 100%)}.flow-list{margin:12px 0 0;padding-left:18px;color:#dbe4ef;display:grid;gap:10px}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.latest-link{display:inline-flex;margin-top:10px;padding:10px 12px;border:1px solid #2a2f3a;border-radius:10px;color:#f5f7fa}.latest-meta{display:grid;gap:8px}.latest-meta strong{font-size:18px}.loading{opacity:.7}.helper{font-size:14px;max-width:46ch}.hero-metric,.quote-actions{display:grid;gap:10px}.status-pill{display:inline-flex;align-items:center;padding:5px 10px;border-radius:999px;border:1px solid currentColor;font-size:12px;font-weight:700;text-transform:capitalize}.status-pill.completed{color:#86efac}.status-pill.processing{color:#fde68a}.status-pill.awaiting_payment,.status-pill.payment_confirmed{color:#7dd3fc}.status-pill.cancelled,.status-pill.expired{color:#fca5a5}.status-pill.draft{color:#d8b4fe}@media(max-width:900px){.layout{grid-template-columns:1fr}.facts-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.form-grid,.facts-grid{grid-template-columns:1fr}.hero,.section-head,.quote-actions{align-items:flex-start;flex-direction:column}}
  </style>

  <script>
    const API = `${window.location.protocol}//${window.location.hostname}:4000/api`;
    const DEMO_USER_ID = '00000000-0000-0000-0000-000000000401';

    const els = {
      notice: document.getElementById('notice'),
      form: document.getElementById('quoteForm'),
      direction: document.getElementById('direction'),
      asset: document.getElementById('asset'),
      network: document.getElementById('network'),
      amountType: document.getElementById('amountType'),
      amount: document.getElementById('amount'),
      fiatCurrency: document.getElementById('fiatCurrency'),
      calculateBtn: document.getElementById('calculateBtn'),
      resetBtn: document.getElementById('resetBtn'),
      createOrderBtn: document.getElementById('createOrderBtn'),
      quoteEmpty: document.getElementById('quoteEmpty'),
      quoteResult: document.getElementById('quoteResult'),
      quoteState: document.getElementById('quoteState'),
      latestOrder: document.getElementById('latestOrder'),
      quoteId: document.getElementById('quoteId'),
      quoteDirection: document.getElementById('quoteDirection'),
      quoteAsset: document.getElementById('quoteAsset'),
      quoteNetwork: document.getElementById('quoteNetwork'),
      quoteFiat: document.getElementById('quoteFiat'),
      quoteCrypto: document.getElementById('quoteCrypto'),
      quoteRate: document.getElementById('quoteRate'),
    };

    let assets = [];
    let networks = [];
    let activeQuote = null;

    const fmt = (value, digits = 2) => Number(value ?? 0).toLocaleString('en-US', { maximumFractionDigits: digits });

    function setNotice(message = '', type = 'error') {
      if (!message) {
        els.notice.hidden = true;
        els.notice.className = 'notice';
        els.notice.textContent = '';
        return;
      }
      els.notice.hidden = false;
      els.notice.className = `notice ${type === 'success' ? 'success' : ''}`.trim();
      els.notice.textContent = message;
    }

    async function api(path, options = {}) {
      const response = await fetch(`${API}${path}`, {
        headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
        ...options,
      });
      const payload = await response.json().catch(() => null);
      if (!response.ok) {
        const message = typeof payload?.message === 'string'
          ? payload.message
          : JSON.stringify(payload ?? {}).slice(0, 200) || `HTTP ${response.status}`;
        throw new Error(message);
      }
      return payload;
    }

    function renderAssets(items) {
      els.asset.innerHTML = items.map((item) => `<option value="${item.code}">${item.code}</option>`).join('');
    }

    function renderNetworks(items) {
      if (!items.length) {
        els.network.innerHTML = '<option value="">No active networks</option>';
        els.network.disabled = true;
        return;
      }
      els.network.disabled = false;
      els.network.innerHTML = items.map((item) => `<option value="${item.code}">${item.code}</option>`).join('');
    }

    async function loadReferenceData() {
      const [assetsPayload, networksPayload] = await Promise.all([
        api('/reference/assets'),
        api('/reference/networks?is_active=true'),
      ]);
      assets = Array.isArray(assetsPayload?.items) ? assetsPayload.items : [];
      networks = Array.isArray(networksPayload?.items) ? networksPayload.items : [];
      renderAssets(assets);
      updateNetworks();
    }

    function updateNetworks() {
      const assetCode = els.asset.value;
      const directionCode = els.direction.value;
      const filtered = networks.filter((item) => {
        const assetMatch = !assetCode || item.assetCode === assetCode || item.asset_code === assetCode;
        const directionMatch = !directionCode || item.directionCode === directionCode || item.direction_code === directionCode;
        return assetMatch && directionMatch && item.isActive !== false && item.is_active !== false;
      });
      renderNetworks(filtered);
    }

    function resetQuote() {
      activeQuote = null;
      els.quoteEmpty.hidden = false;
      els.quoteResult.hidden = true;
      els.quoteState.textContent = 'Waiting for calculation';
      els.createOrderBtn.disabled = true;
    }

    function renderQuote(payload) {
      const quote = payload?.item ?? payload;
      activeQuote = quote;
      els.quoteEmpty.hidden = true;
      els.quoteResult.hidden = false;
      els.quoteState.textContent = 'Quote ready';
      els.createOrderBtn.disabled = false;
      els.quoteId.textContent = quote.quote_id ?? quote.id ?? '—';
      els.quoteDirection.textContent = quote.direction_code ?? els.direction.value;
      els.quoteAsset.textContent = quote.asset_code ?? els.asset.value;
      els.quoteNetwork.textContent = quote.network_code ?? els.network.value;
      els.quoteFiat.textContent = `${fmt(quote.fiat_amount ?? quote.fiatAmount, 2)} ${els.fiatCurrency.value.toUpperCase()}`;
      els.quoteCrypto.textContent = `${fmt(quote.crypto_amount ?? quote.cryptoAmount, 8)} ${els.asset.value}`;
      els.quoteRate.textContent = fmt(quote.rate, 6);
    }

    function renderLatestOrder(order) {
      els.latestOrder.innerHTML = `
        <div class="latest-meta">
          <span class="status-pill ${order.statusCode || 'draft'}">${order.statusCode || 'draft'}</span>
          <strong>${order.publicId}</strong>
          <span>${fmt(order.fiatAmount, 2)} fiat · ${fmt(order.cryptoAmount, 8)} crypto</span>
          <a class="latest-link" href="/orders/${order.publicId}">Open order detail</a>
        </div>
      `;
    }

    async function calculateQuote(event) {
      event.preventDefault();
      setNotice('');
      resetQuote();
      els.calculateBtn.disabled = true;
      els.quoteState.textContent = 'Calculating…';

      try {
        const payload = await api('/quotes/calculate', {
          method: 'POST',
          body: JSON.stringify({
            direction_code: els.direction.value,
            fiat_currency_code: els.fiatCurrency.value.trim().toUpperCase(),
            asset_code: els.asset.value,
            network_code: els.network.value,
            amount_type: els.amountType.value,
            amount: Number(els.amount.value),
          }),
        });
        renderQuote(payload);
        setNotice('Quote calculated successfully. You can create the order now.', 'success');
      } catch (error) {
        els.quoteState.textContent = 'Calculation failed';
        setNotice(error.message || 'Failed to calculate quote.');
      } finally {
        els.calculateBtn.disabled = false;
      }
    }

    async function createOrder() {
      if (!activeQuote?.quote_id) {
        setNotice('Calculate a quote before creating an order.');
        return;
      }
      setNotice('');
      els.createOrderBtn.disabled = true;
      els.createOrderBtn.textContent = 'Creating…';

      try {
        const order = await api('/orders', {
          method: 'POST',
          body: JSON.stringify({
            quote_id: activeQuote.quote_id,
            user_id: DEMO_USER_ID,
          }),
        });
        renderLatestOrder(order);
        setNotice(`Order ${order.publicId} created successfully. Redirecting to detail flow…`, 'success');
        setTimeout(() => {
          window.location.href = `/orders/${order.publicId}`;
        }, 700);
      } catch (error) {
        setNotice(error.message || 'Failed to create order.');
      } finally {
        els.createOrderBtn.disabled = false;
        els.createOrderBtn.textContent = 'Create order';
      }
    }

    els.form.addEventListener('submit', calculateQuote);
    els.direction.addEventListener('change', () => { updateNetworks(); resetQuote(); });
    els.asset.addEventListener('change', () => { updateNetworks(); resetQuote(); });
    els.amountType.addEventListener('change', resetQuote);
    els.amount.addEventListener('input', resetQuote);
    els.fiatCurrency.addEventListener('input', resetQuote);
    els.resetBtn.addEventListener('click', () => { els.form.reset(); els.fiatCurrency.value = 'RUB'; els.amount.value = '15000'; updateNetworks(); resetQuote(); setNotice(''); });
    els.createOrderBtn.addEventListener('click', createOrder);

    resetQuote();
    loadReferenceData().catch((error) => {
      setNotice(error.message || 'Failed to load reference data.');
      els.calculateBtn.disabled = true;
    });
  </script>
</BaseLayout>
