---
import BaseLayout from "../layouts/BaseLayout.astro";
import CabinetHero from "../components/CabinetHero.astro";
import MetricCard from "../components/MetricCard.astro";
import SectionHead from "../components/SectionHead.astro";
---
<BaseLayout title="Dashboard">
  <CabinetHero
    title="Lifecycle dashboard"
    lede="Единая сводка по заказам, действиям клиента, уведомлениям, кошелькам и payout requisites для ежедневного customer journey."
    actionHref="/"
    actionLabel="Create order"
  />

  <div id="notice" class="notice" hidden></div>

  <section class="metrics-grid">
    <MetricCard
      label="Open orders"
      valueId="ordersOpen"
      description="Orders still moving through draft, payment and processing states."
      accent={true}
    />
    <MetricCard
      label="Need customer action"
      valueId="needsAction"
      description="Requests most likely waiting for payment or early follow-up."
    />
    <MetricCard
      label="Unread notifications"
      valueId="notificationsUnread"
      description="Recent customer-facing updates still not seen or reviewed."
    />
    <MetricCard
      label="Saved wallets"
      valueId="walletsTotal"
      description="Customer crypto destinations currently stored in the cabinet."
    />
  </section>

  <section class="layout">
    <div class="stack">
      <section class="card insight-card">
        <SectionHead eyebrow="Focus today" title="Preparing dashboard insight…" metaId="focusMeta" metaText="Loading" />
        <p class="lede" id="focusCopy">The dashboard will explain the most important next step across current customer orders.</p>
      </section>

      <section class="card panel-wide">
        <SectionHead eyebrow="Orders" title="Priority lifecycle queue" linkHref="/orders" linkLabel="Open all orders" />
        <div id="ordersList" class="feed"><p class="empty">Loading orders…</p></div>
      </section>

      <section class="two-col">
        <section class="card">
          <SectionHead eyebrow="Wallets" title="Saved destinations" linkHref="/wallets" linkLabel="Open wallets" />
          <div id="walletsList" class="feed"><p class="empty">Loading wallets…</p></div>
        </section>

        <section class="card">
          <SectionHead eyebrow="Payouts" title="Customer payout methods" />
          <div id="payoutsList" class="feed"><p class="empty">Loading payout requisites…</p></div>
        </section>
      </section>
    </div>

    <aside class="stack">
      <section class="card">
        <SectionHead eyebrow="Notifications" title="Recent customer updates" linkHref="/notifications" linkLabel="Open all" />
        <div id="notificationsList" class="feed"><p class="empty">Loading notifications…</p></div>
      </section>

      <section class="card">
        <SectionHead eyebrow="Quick links" title="Customer journey" />
        <div class="quick-links">
          <a href="/">Create a new order</a>
          <a href="/orders">Track all orders</a>
          <a href="/wallets">Manage wallets and payouts</a>
          <a href="/account">Review customer account</a>
        </div>
      </section>
    </aside>
  </section>

  <style>
    .notice{margin:0 0 16px;padding:12px 14px;border:1px solid #7f1d1d;background:#2b1618;border-radius:10px;color:#fecaca}.metrics-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:16px}.lede,.tiny,.feed-item p{color:#b6c0cf}.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.95fr);gap:16px}.stack,.feed,.quick-links{display:grid;gap:16px}.two-col{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.panel-wide,.insight-card{min-height:0}.feed-item{padding:14px;border:1px solid #2a2f3a;border-radius:12px;background:#11151c;display:grid;gap:8px}.feed-item h4,.feed-item p{margin:0}.feed-meta{display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.empty{color:#8b98ab}.quick-links a{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border:1px solid #2a2f3a;border-radius:12px;background:#0f1115}@media(max-width:1120px){.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:1fr}}@media(max-width:760px){.metrics-grid,.two-col{grid-template-columns:1fr}.feed-meta{align-items:flex-start;flex-direction:column}}
  </style>

  <script>
    const API = `${window.location.protocol}//${window.location.hostname}:4000/api`;
    const noticeEl = document.getElementById('notice');

    function setNotice(message = '') {
      if (!message) {
        noticeEl.hidden = true;
        noticeEl.textContent = '';
        return;
      }
      noticeEl.hidden = false;
      noticeEl.textContent = message;
    }

    async function fetchJson(path) {
      const response = await fetch(`${API}${path}`);
      const payload = await response.json().catch(() => null);
      if (!response.ok) throw new Error(payload?.message || `HTTP ${response.status}`);
      return payload;
    }

    function normalizeStatus(order) {
      return order.statusCode || order.status_code || 'draft';
    }

    function statusMarkup(text, tone) {
      return `<span class="status-pill ${tone}">${text}</span>`;
    }

    function renderOrders(items = []) {
      const activeItems = items.filter((item) => ['draft', 'awaiting_payment', 'payment_confirmed', 'processing'].includes(normalizeStatus(item)));
      const needsAction = items.filter((item) => ['draft', 'awaiting_payment'].includes(normalizeStatus(item)));
      document.getElementById('ordersOpen').textContent = String(activeItems.length);
      document.getElementById('needsAction').textContent = String(needsAction.length);
      document.getElementById('ordersList').innerHTML = activeItems.length ? activeItems.slice(0, 5).map((item) => `
        <article class="feed-item">
          <div class="feed-meta">
            <h4>${item.publicId || item.public_id || '—'}</h4>
            ${statusMarkup(normalizeStatus(item), normalizeStatus(item))}
          </div>
          <p>${item.directionCode || item.direction_code || '—'} · ${item.assetCode || item.asset_code || '—'}</p>
          <p>Updated ${new Date(item.updatedAt).toLocaleString('ru-RU', { dateStyle: 'short', timeStyle: 'short' })}</p>
          <a class="text-link" href="/orders/${item.publicId || item.public_id}">Open detail</a>
        </article>
      `).join('') : '<p class="empty">No active orders found.</p>';
      return { activeItems, needsAction };
    }

    function renderNotifications(items = []) {
      const unread = items.filter((item) => item.isRead === false || item.is_read === false);
      document.getElementById('notificationsUnread').textContent = String(unread.length);
      document.getElementById('notificationsList').innerHTML = items.length ? items.slice(0, 4).map((item) => `
        <article class="feed-item">
          <div class="feed-meta">
            <h4>${item.title || item.templateCode || item.template_code || 'Notification'}</h4>
            <span>${new Date(item.createdAt).toLocaleString('ru-RU', { dateStyle: 'short', timeStyle: 'short' })}</span>
          </div>
          <p>${item.body || 'No message body'}</p>
        </article>
      `).join('') : '<p class="empty">No recent notifications found.</p>';
      return unread;
    }

    function renderWallets(items = []) {
      document.getElementById('walletsTotal').textContent = String(items.length);
      document.getElementById('walletsList').innerHTML = items.length ? items.slice(0, 4).map((item) => `
        <article class="feed-item">
          <div class="feed-meta">
            <h4>${item.label || item.assetCode || item.asset_code || 'Wallet'}</h4>
            <span>${item.networkCode || item.network_code || '—'}</span>
          </div>
          <p class="mono">${item.address || '—'}</p>
        </article>
      `).join('') : '<p class="empty">No wallets saved yet.</p>';
    }

    function renderPayouts(items = []) {
      document.getElementById('payoutsList').innerHTML = items.length ? items.slice(0, 4).map((item) => `
        <article class="feed-item">
          <div class="feed-meta">
            <h4>${item.bankName || item.providerName || 'Payout method'}</h4>
            <span>${item.fiatCurrencyCode || item.fiat_currency_code || '—'}</span>
          </div>
          <p>${item.recipientName || item.accountHolder || 'Recipient not specified'}</p>
        </article>
      `).join('') : '<p class="empty">No payout requisites saved yet.</p>';
    }

    function renderFocus(ordersContext, unread) {
      const { activeItems, needsAction } = ordersContext;
      const titleEl = document.querySelector('#focusMeta')?.previousElementSibling?.querySelector('h3') || document.querySelector('.insight-card h3');
      const copyEl = document.getElementById('focusCopy');
      const metaEl = document.getElementById('focusMeta');

      if (needsAction.length) {
        titleEl.textContent = 'Customer action is the main blocker';
        copyEl.textContent = 'At least one order still depends on payment or early customer follow-up before it can move deeper into execution.';
        metaEl.textContent = `${needsAction.length} action items`;
        return;
      }
      if (unread.length) {
        titleEl.textContent = 'Unread updates need review';
        copyEl.textContent = 'There are no urgent payment blockers, but customer-facing updates still need visibility review to keep the lifecycle smooth.';
        metaEl.textContent = `${unread.length} unread`;
        return;
      }
      if (activeItems.length) {
        titleEl.textContent = 'Active lifecycle looks stable';
        copyEl.textContent = 'Orders, saved destinations and customer updates look aligned well enough for routine execution.';
        metaEl.textContent = `${activeItems.length} active orders`;
        return;
      }
      titleEl.textContent = 'No active pressure points';
      copyEl.textContent = 'There are currently no active orders in motion, so the cabinet is ready for the next customer request.';
      metaEl.textContent = 'Ready';
    }

    async function loadDashboard() {
      const refreshButton = document.getElementById('refresh');
      refreshButton.disabled = true;
      setNotice('');
      try {
        const [ordersSummary, notifications, wallets, payouts] = await Promise.all([
          fetchJson('/auth/me/orders-summary'),
          fetchJson('/notifications'),
          fetchJson('/wallets'),
          fetchJson('/payout-requisites'),
        ]);

        const orders = Array.isArray(ordersSummary?.items) ? ordersSummary.items : [];
        const notificationItems = Array.isArray(notifications?.items) ? notifications.items : [];
        const walletItems = Array.isArray(wallets?.items) ? wallets.items : [];
        const payoutItems = Array.isArray(payouts?.items) ? payouts.items : [];

        const ordersContext = renderOrders(orders);
        const unread = renderNotifications(notificationItems);
        renderWallets(walletItems);
        renderPayouts(payoutItems);
        renderFocus(ordersContext, unread);
      } catch (error) {
        setNotice(error.message || 'Failed to load dashboard data.');
      } finally {
        refreshButton.disabled = false;
      }
    }

    document.getElementById('refresh').addEventListener('click', loadDashboard);
    loadDashboard();
  </script>
</BaseLayout>
