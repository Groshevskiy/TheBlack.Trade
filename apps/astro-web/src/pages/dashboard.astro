---
import BaseLayout from "../layouts/BaseLayout.astro";
import CabinetHero from "../components/CabinetHero.astro";
import MetricCard from "../components/MetricCard.astro";
import QuickLinks from "../components/QuickLinks.astro";
import InsightCard from "../components/InsightCard.astro";
import StatusPill from "../components/StatusPill.astro";
import EmptyState from "../components/EmptyState.astro";
import FeedPanel from "../components/FeedPanel.astro";

const quickLinkItems = [
  { href: '/', label: 'Create a new order' },
  { href: '/orders', label: 'Track all orders' },
  { href: '/wallets', label: 'Manage wallets and payouts' },
  { href: '/account', label: 'Review customer account' },
];
---
<BaseLayout title="Dashboard">
  <CabinetHero title="Lifecycle dashboard" lede="Единая сводка по заказам, действиям клиента, уведомлениям, кошелькам и payout requisites для ежедневного customer journey." actionHref="/" actionLabel="Create order" />
  <div id="notice" class="notice" hidden></div>

  <section class="metrics-grid">
    <MetricCard label="Open orders" valueId="ordersOpen" description="Orders still moving through draft, payment and processing states." accent={true} />
    <MetricCard label="Need customer action" valueId="needsAction" description="Requests most likely waiting for payment or early follow-up." />
    <MetricCard label="Unread notifications" valueId="notificationsUnread" description="Recent customer-facing updates still not seen or reviewed." />
    <MetricCard label="Saved wallets" valueId="walletsTotal" description="Customer crypto destinations currently stored in the cabinet." />
  </section>

  <section class="layout">
    <div class="stack">
      <InsightCard eyebrow="Focus today" titleId="focusTitle" title="Preparing dashboard insight…" copyId="focusCopy" copy="The dashboard will explain the most important next step across current customer orders." />

      <FeedPanel eyebrow="Orders" title="Priority lifecycle queue" linkHref="/orders" linkLabel="Open all orders" className="panel-wide">
        <div id="ordersList" class="feed"><EmptyState message="Loading orders…" /></div>
      </FeedPanel>

      <section class="two-col">
        <FeedPanel eyebrow="Wallets" title="Saved destinations" linkHref="/wallets" linkLabel="Open wallets">
          <div id="walletsList" class="feed"><EmptyState message="Loading wallets…" /></div>
        </FeedPanel>

        <FeedPanel eyebrow="Payouts" title="Customer payout methods">
          <div id="payoutsList" class="feed"><EmptyState message="Loading payout requisites…" /></div>
        </FeedPanel>
      </section>
    </div>

    <aside class="stack">
      <FeedPanel eyebrow="Notifications" title="Recent customer updates" linkHref="/notifications" linkLabel="Open all">
        <div id="notificationsList" class="feed"><EmptyState message="Loading notifications…" /></div>
      </FeedPanel>

      <section class="card"><h3 style="margin:0 0 16px">Customer journey</h3><QuickLinks items={quickLinkItems} /></section>
    </aside>
  </section>

  <template id="status-pill-template"><StatusPill text="template" /></template>

  <style>
    .notice{margin:0 0 16px;padding:12px 14px;border:1px solid #7f1d1d;background:#2b1618;border-radius:10px;color:#fecaca}.metrics-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:16px}.feed-item p{color:#b6c0cf}.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.95fr);gap:16px}.stack,.feed{display:grid;gap:16px}.two-col{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.feed-item{padding:14px;border:1px solid #2a2f3a;border-radius:12px;background:#11151c;display:grid;gap:8px}.feed-item h4,.feed-item p{margin:0}.feed-meta{display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.text-link{color:#7dd3fc}@media(max-width:1120px){.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:1fr}}@media(max-width:760px){.metrics-grid,.two-col{grid-template-columns:1fr}.feed-meta{align-items:flex-start;flex-direction:column}}
  </style>

  <script type="module">
    import { emptyMarkup, fetchJson, formatRuDate, renderStatusPill, setNotice } from '../components/cabinetClient.ts';

    const statusPillTemplate = document.getElementById('status-pill-template');

    function normalizeStatus(order) { return order.statusCode || order.status_code || 'draft'; }
    function renderStatusPill(statusPillTemplate, text, tone) {
      const raw = statusPillTemplate.innerHTML.trim(); return raw.replace('template', text).replace('neutral', tone || 'neutral');
    }
    function renderOrders(items = []) {
      const activeItems = items.filter((item) => ['draft', 'awaiting_payment', 'payment_confirmed', 'processing'].includes(normalizeStatus(item)));
      const needsAction = items.filter((item) => ['draft', 'awaiting_payment'].includes(normalizeStatus(item)));
      document.getElementById('ordersOpen').textContent = String(activeItems.length); document.getElementById('needsAction').textContent = String(needsAction.length);
      document.getElementById('ordersList').innerHTML = activeItems.length ? activeItems.slice(0, 5).map((item) => `<article class="feed-item"><div class="feed-meta"><h4>${item.publicId || item.public_id || '—'}</h4>${renderStatusPill(statusPillTemplate, normalizeStatus(item), normalizeStatus(item))}</div><p>${item.directionCode || item.direction_code || '—'} · ${item.assetCode || item.asset_code || '—'}</p><p>Updated ${formatRuDate(item.updatedAt)}</p><a class="text-link" href="/orders/${item.publicId || item.public_id}">Open detail</a></article>`).join('') : emptyMarkup('No active orders found.');
      return { activeItems, needsAction };
    }
    function renderNotifications(items = []) {
      const unread = items.filter((item) => item.isRead === false || item.is_read === false); document.getElementById('notificationsUnread').textContent = String(unread.length);
      document.getElementById('notificationsList').innerHTML = items.length ? items.slice(0, 4).map((item) => `<article class="feed-item"><div class="feed-meta"><h4>${item.title || item.templateCode || item.template_code || 'Notification'}</h4><span>${formatRuDate(item.createdAt)}</span></div><p>${item.body || 'No message body'}</p></article>`).join('') : emptyMarkup('No recent notifications found.'); return unread;
    }
    function renderWallets(items = []) { document.getElementById('walletsTotal').textContent = String(items.length); document.getElementById('walletsList').innerHTML = items.length ? items.slice(0, 4).map((item) => `<article class="feed-item"><div class="feed-meta"><h4>${item.label || item.assetCode || item.asset_code || 'Wallet'}</h4><span>${item.networkCode || item.network_code || '—'}</span></div><p class="mono">${item.address || '—'}</p></article>`).join('') : emptyMarkup('No wallets saved yet.'); }
    function renderPayouts(items = []) { document.getElementById('payoutsList').innerHTML = items.length ? items.slice(0, 4).map((item) => `<article class="feed-item"><div class="feed-meta"><h4>${item.bankName || item.providerName || 'Payout method'}</h4><span>${item.fiatCurrencyCode || item.fiat_currency_code || '—'}</span></div><p>${item.recipientName || item.accountHolder || 'Recipient not specified'}</p></article>`).join('') : emptyMarkup('No payout requisites saved yet.'); }
    function renderFocus({ activeItems, needsAction }, unread) {
      const titleEl = document.getElementById('focusTitle'); const copyEl = document.getElementById('focusCopy');
      if (needsAction.length) { titleEl.textContent = 'Customer action is the main blocker'; copyEl.textContent = 'At least one order still depends on payment or early customer follow-up before it can move deeper into execution.'; return; }
      if (unread.length) { titleEl.textContent = 'Unread updates need review'; copyEl.textContent = 'There are no urgent payment blockers, but customer-facing updates still need visibility review to keep the lifecycle smooth.'; return; }
      if (activeItems.length) { titleEl.textContent = 'Active lifecycle looks stable'; copyEl.textContent = 'Orders, saved destinations and customer updates look aligned well enough for routine execution.'; return; }
      titleEl.textContent = 'No active pressure points'; copyEl.textContent = 'There are currently no active orders in motion, so the cabinet is ready for the next customer request.';
    }
    async function loadDashboard() {
      const refreshButton = document.getElementById('refresh'); refreshButton.disabled = true; setNotice('');
      try {
        const summary = await fetchJson('/auth/me/summary');
        const currentUser = summary?.user || summary?.item?.user || {};
        const userId = currentUser?.id;

        if (!userId) {
          throw new Error('Missing user_id for notifications request.');
        }

        const [ordersSummary, notifications, wallets, payouts] = await Promise.all([fetchJson('/auth/me/orders-summary'), fetchJson(`/notifications?user_id=${encodeURIComponent(userId)}`), fetchJson('/wallets'), fetchJson('/payout-requisites')]);
        const orders = Array.isArray(ordersSummary?.items) ? ordersSummary.items : []; const notificationItems = Array.isArray(notifications?.items) ? notifications.items : []; const walletItems = Array.isArray(wallets?.items) ? wallets.items : []; const payoutItems = Array.isArray(payouts?.items) ? payouts.items : [];
        const ordersContext = renderOrders(orders); const unread = renderNotifications(notificationItems); renderWallets(walletItems); renderPayouts(payoutItems); renderFocus(ordersContext, unread);
      } catch (error) { setNotice(error.message || 'Failed to load dashboard data.'); } finally { refreshButton.disabled = false; }
    }
    document.getElementById('refresh').addEventListener('click', loadDashboard); loadDashboard();
  </script>
</BaseLayout>
