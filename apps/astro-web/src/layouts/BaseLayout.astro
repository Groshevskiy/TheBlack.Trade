---
export interface Props {
  title?: string;
}
const { title = 'TheBlack.Trade' } = Astro.props;
const path = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Create' },
  { href: '/dashboard', label: 'Dashboard' },
  { href: '/orders', label: 'Orders' },
  { href: '/wallets', label: 'Settlement' },
  { href: '/notifications', label: 'Notifications' },
  { href: '/account', label: 'Account' },
  { href: '/operator/orders', label: 'Operator' },
];
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #0f1115;
        --surface: #171a21;
        --surface-soft: #11151c;
        --surface-accent: #131e24;
        --line: #2a2f3a;
        --text: #f5f7fa;
        --muted: #b6c0cf;
        --faint: #8b98ab;
        --accent: #7dd3fc;
        --accent-ink: #07111a;
        --accent-soft: #0f1722;
        --success: #86efac;
        --warning: #fde68a;
        --danger: #fca5a5;
        --draft: #d8b4fe;
        --radius: 14px;
        --radius-sm: 10px;
        --shadow: 0 18px 48px rgba(0, 0, 0, 0.24);
        font-family: Inter, system-ui, sans-serif;
      }

      * { box-sizing: border-box; }
      html { background: var(--bg); }
      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(125, 211, 252, 0.08), transparent 24%),
          radial-gradient(circle at top right, rgba(192, 132, 252, 0.06), transparent 20%),
          var(--bg);
        color: var(--text);
      }

      a { color: var(--accent); text-decoration: none; }
      button, input, select { font: inherit; }

      .shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 260px 1fr;
      }

      .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        padding: 28px 20px;
        border-right: 1px solid var(--line);
        background: rgba(12, 14, 18, 0.9);
        backdrop-filter: blur(14px);
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .brand {
        display: grid;
        gap: 8px;
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        border: 1px solid rgba(125, 211, 252, 0.45);
        background: linear-gradient(180deg, rgba(125, 211, 252, 0.18), rgba(125, 211, 252, 0.05));
        position: relative;
      }

      .brand-mark::after {
        content: '';
        position: absolute;
        width: 12px;
        height: 12px;
        border-radius: 999px;
        background: var(--accent);
        right: -4px;
        top: -4px;
        box-shadow: 0 0 0 6px rgba(125, 211, 252, 0.12);
      }

      .brand h1 { margin: 0; font-size: 22px; letter-spacing: -0.04em; }
      .brand p { margin: 0; color: var(--muted); font-size: 14px; max-width: 24ch; }

      .nav-group {
        display: grid;
        gap: 8px;
      }

      .nav-label {
        color: var(--faint);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
      }

      nav {
        display: grid;
        gap: 6px;
      }

      .nav-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid transparent;
        color: var(--muted);
        background: transparent;
        transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
      }

      .nav-link:hover {
        border-color: rgba(125, 211, 252, 0.18);
        background: rgba(125, 211, 252, 0.06);
        color: var(--text);
      }

      .nav-link.active {
        border-color: rgba(125, 211, 252, 0.32);
        background: rgba(125, 211, 252, 0.12);
        color: var(--text);
      }

      .nav-link span:last-child {
        font-size: 12px;
        color: var(--faint);
      }

      .sidebar-card {
        margin-top: auto;
        padding: 16px;
        border-radius: var(--radius);
        border: 1px solid var(--line);
        background: linear-gradient(180deg, rgba(23, 26, 33, 0.98), rgba(17, 21, 28, 0.94));
        display: grid;
        gap: 8px;
      }

      .sidebar-card strong { font-size: 15px; }
      .sidebar-card p { margin: 0; color: var(--muted); font-size: 14px; }

      .sidebar-card a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid rgba(125, 211, 252, 0.24);
        background: rgba(125, 211, 252, 0.08);
      }

      .content {
        min-width: 0;
        padding: 28px;
      }

      .page-frame {
        max-width: 1220px;
        margin: 0 auto;
        display: grid;
        gap: 16px;
      }

      .page-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .page-top h2 {
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
      }

      .page-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: rgba(23, 26, 33, 0.8);
        color: var(--muted);
        font-size: 13px;
      }

      .dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--accent);
        box-shadow: 0 0 0 5px rgba(125, 211, 252, 0.12);
      }

      .card {
        background: linear-gradient(180deg, rgba(23, 26, 33, 0.98), rgba(17, 21, 28, 0.94));
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: var(--shadow);
      }

      .grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }

      @media (max-width: 980px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar {
          position: static;
          height: auto;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }
        .content { padding: 20px; }
      }

      @media (max-width: 640px) {
        .content { padding: 16px; }
        .sidebar { padding: 20px 16px; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-mark"></div>
          <div>
            <h1>TheBlack.Trade</h1>
            <p>Customer cabinet for quote, order lifecycle, notifications and settlement management.</p>
          </div>
        </div>

        <div class="nav-group">
          <span class="nav-label">Cabinet</span>
          <nav>
            {navItems.map((item) => {
              const active = item.href === '/' ? path === '/' : path.startsWith(item.href);
              return (
                <a class={`nav-link ${active ? 'active' : ''}`} href={item.href}>
                  <span>{item.label}</span>
                  <span>{active ? 'Open' : 'Go'}</span>
                </a>
              );
            })}
          </nav>
        </div>

        <div class="sidebar-card">
          <strong>Live customer flow</strong>
          <p>Start with a quote, create an order, then track settlement and communication from one cabinet.</p>
          <a href="/">Create new order</a>
        </div>
      </aside>

      <main class="content">
        <div class="page-frame">
          <div class="page-top">
            <h2>{title}</h2>
            <span class="page-pill"><span class="dot"></span> Cabinet experience</span>
          </div>
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
