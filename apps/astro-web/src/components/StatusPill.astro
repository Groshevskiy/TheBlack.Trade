---
export interface Props {
  text: string;
  tone?: string;
}

const { text, tone = 'neutral' } = Astro.props;
---
<span class={`status-pill ${tone}`}>{text}</span>

<style>
  .status-pill{display:inline-flex;align-items:center;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid currentColor}.status-pill.good,.status-pill.completed,.status-pill.read{color:#86efac}.status-pill.warn,.status-pill.processing{color:#fde68a}.status-pill.awaiting_payment,.status-pill.payment_confirmed,.status-pill.neutral,.status-pill.unread{color:#7dd3fc}.status-pill.cancelled,.status-pill.expired{color:#fca5a5}.status-pill.draft{color:#d8b4fe}
</style>
